{
    "name": "sparkus-monorepo",
    "private": true,
    "type": "module",
    "description": "Sparkus v1: the fastest decorator + DI backend framework for TypeScript, built for Bun and Node.",
    "license": "MIT",
    "author": "Maxandre <contact@maxand.re>",
    "repository": {
        "type": "git",
        "url": "https://github.com/SparkusFramework/Sparkus.git"
    },
    "workspaces": [
        "packages/*",
        "tests/*",
        "bench",
        "spike"
    ],
    "scripts": {
        "build": "bun scripts/build.ts",
        "build:types": "tsc -b --force packages/sparkus packages/testing packages/cli",
        "typecheck": "bun check -b && bun check -p tsconfig.test.json",
        "test": "bun run build && bun test ./packages ./tests",
        "check:deps": "bun scripts/check-deps.ts",
        "bench": "bun run --cwd bench bench"
    },
    "devDependencies": {
        "@types/bun": "^1.3.0",
        "@types/node": "^24.0.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=22.0.0"
    }
}
