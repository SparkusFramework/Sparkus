{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "composite": true,
        "skipLibCheck": true,
        "types": ["node"]
    }
}
