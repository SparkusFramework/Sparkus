{
    "name": "@sparkus/bench",
    "version": "0.0.0",
    "private": true,
    "description": "Reproducible HTTP benchmark: Sparkus vs NestJS, Fastify, Express, Elysia, Hono and raw servers.",
    "type": "module",
    "scripts": {
        "build": "bun run --cwd .. build && bun run --cwd ../spike build && tsc -p targets/sparkus/tsconfig.json && tsc -p targets/sparkus-pipeline/tsconfig.json && tsc -p targets/spike/tsconfig.json && tsc -p targets/nest/tsconfig.json",
        "bench": "bun run build && bun run.ts"
    },
    "dependencies": {
        "sparkus": "workspace:*",
        "@sparkus/spike": "workspace:*",
        "@hono/node-server": "^1.14.0",
        "@hono/zod-validator": "^0.7.0",
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/platform-fastify": "^11.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "elysia": "^1.3.0",
        "express": "^5.1.0",
        "fastify": "^5.3.0",
        "hono": "^4.7.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "autocannon": "^8.0.0",
        "typescript": "^5.9.3"
    }
}
